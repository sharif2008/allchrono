# Backend (API) environment — copy to apps/api/.env for local standalone runs.
# In Docker these are provided by docker-compose.yml (DATABASE_URL points at the
# "postgres" service instead of localhost).

# Host port 5433 (see docker-compose.yml) avoids clashing with a local Postgres on 5432.
DATABASE_URL=postgresql://allchrono:allchrono@localhost:5433/allchrono?schema=public
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=1d
API_PORT=3001
# Escrow funding deadline after AUTH_PASSED, in hours
ESCROW_DUE_HOURS=48
# Static signing key for the passport hash-chain (NOT a real key)
PASSPORT_SIGNING_KEY=allchrono-static-dev-signing-key
PASSPORT_SIGNER=allchrono-system
# CORS: which web origin may call the API
WEB_ORIGIN=http://localhost:3000
