# Frontend (web) environment — copy to apps/web/.env for local standalone runs.
# In Docker these are provided by docker-compose.yml (API_INTERNAL_URL points at
# the "api" service).

# Browser -> API (same in local and Docker; the browser hits the host port).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server Components -> API. Local: localhost. Docker overrides to http://api:3001.
API_INTERNAL_URL=http://localhost:3001
